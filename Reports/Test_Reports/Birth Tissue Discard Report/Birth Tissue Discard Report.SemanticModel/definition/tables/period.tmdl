	partition period = calculated
		mode: import
		source = ```
				UNION(
				    ADDCOLUMNS(
				        CALENDAR( DATE(YEAR(TODAY()), 01, 01), TODAY() ), 
				        "Period", "YTD"
				    ), 
				    ADDCOLUMNS(
				        CALENDAR( MIN(_date_table[Date]), MAX(_date_table[Date]) ), 
				        "Period", "All Dates"
				    )
				
				)
				```

	annotation PBI_Id = 845fba2d5d174c93898064c7c7bcb227

